<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/setting_category_input_method_title">

        <Preference
            android:icon="@drawable/keyboard_24px"
            android:key="keyboard_selection_preference"
            android:summary="@string/keyboard_selection_summary"
            android:title="@string/keyboard_selection_preference_title" />

        <ListPreference
            android:defaultValue="default"
            android:entries="@array/type_null_input_behavior_entries"
            android:entryValues="@array/type_null_input_behavior_values"
            android:key="type_null_input_behavior_preference"
            android:summary="@string/type_null_input_behavior_summary"
            android:title="@string/type_null_input_behavior_title" />

        <Preference
            android:icon="@drawable/language_japanese_kana_24px"
            android:key="setting_route_sumire_preferences"
            android:summary="@string/setting_route_sumire_summary"
            android:title="@string/category_sumire_input_keyboard_title" />

        <Preference
            android:icon="@drawable/kana_small"
            android:key="setting_route_kana_preferences"
            android:summary="@string/setting_route_kana_summary"
            android:title="@string/category_kana" />

        <Preference
            android:icon="@drawable/input_mode_english_select"
            android:key="setting_route_qwerty_preferences"
            android:title="@string/qwerty_common_category_title" />

        <Preference
            android:icon="@drawable/input_mode_english_select"
            android:key="setting_route_qwerty_english_preferences"
            android:title="@string/qwerty_english_category_title" />

        <Preference
            android:icon="@drawable/input_mode_english_select"
            android:key="setting_route_qwerty_romaji_preferences"
            android:title="@string/qwerty_romaji_category_title" />

        <Preference
            android:icon="@drawable/ic_custom_icon"
            android:key="setting_route_custom_keyboard_preferences"
            android:summary="@string/setting_route_custom_keyboard_summary"
            android:title="@string/category_custom_keyboard_title" />

        <Preference
            android:icon="@drawable/keyboard_tab_24px"
            android:key="setting_route_tablet_preferences"
            android:summary="@string/setting_route_tablet_summary"
            android:title="@string/tablet_preference_category_title" />

        <Preference
            android:icon="@drawable/keyboard_command_key_24px"
            android:key="setting_route_hardware_keyboard_preferences"
            android:summary="@string/setting_route_hardware_keyboard_summary"
            android:title="@string/hardware_keyboard_category_title" />

    </PreferenceCategory>

    <PreferenceCategory android:title="ダブルタップ促音">
        <SwitchPreferenceCompat android:key="double_tap_small_tsu_enabled"
            android:defaultValue="false" android:title="ダブルタップで促音を入力"
            android:summary="1回目は直ちに入力し、2回目で「っ＋出力」に置換します。連打は2回ずつで1組です。トグル入力では無効です。" />
        <SeekBarPreference android:key="double_tap_small_tsu_interval"
            android:defaultValue="200" app:min="50" android:max="500"
            app:seekBarIncrement="1" app:showSeekBarValue="true"
            android:title="判定時間（ミリ秒）"
            android:summary="1回目を離してから2回目に触れるまで。初期200ms、50〜500ms。短くすると意図しない促音が減る一方、促音を出すには素早い操作が必要になります。2回目のフリックを終えるまでの時間ではありません。" />
        <MultiSelectListPreference android:key="double_tap_small_tsu_rows"
            android:entries="@array/small_tsu_rows" android:entryValues="@array/small_tsu_rows"
            android:defaultValue="@array/small_tsu_default_rows"
            android:title="促音化する文字の行"
            android:summary="2回目に実際に入力する文字列の先頭で行を判定します。キーの表示や1回目の文字では判定しません。先頭がカタカナなら「ッ」を付けます。" />
        <Preference android:title="対象になる出力"
            android:summary="対象行のかなで始まる2回目の出力が対象です。「っ・ッ・ん・ン」始まりや、漢字・英数字・空白・一般の記号を含む出力などは対象外です。1回目のタップが「っか」、2回目が「き」なら、1回目の未確定入力全体を置き換え「っき」になります。"
            android:selectable="false" />
        <Preference android:title="意図しない促音が入るとき"
            android:summary="同じキーを時間内に操作すると、普通に「かく」と入力したつもりでも「っく」になります。判定時間を短くするか、2回の間をその時間より長く空けてください。必要に応じて対象行や全体のON/OFFも調整できます。"
            android:selectable="false" />
        <Preference android:title="連打とショートカット"
            android:summary="「か」の連打は、か → っか → っかか → っかっか。「かっか」は最初の「か」の後で判定時間を超えて区切ります。ショートカットバー設定で「ダブルタップ促音」を追加するとON/OFFを切り替えられます。既存のダブルタップ割当てを優先します。"
            android:selectable="false" />
    </PreferenceCategory>

</PreferenceScreen>
